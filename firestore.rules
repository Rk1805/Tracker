rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Staff: any user who signed in with email/password
    // (our phone-derived credentials use the 'password' provider)
    function isStaff() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider == 'password';
    }

    // Customer: any anonymously authenticated user
    function isCustomerAuth() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isTemporaryCustomer() {
      return isCustomerAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.temporaryPhoneLogin == true;
    }

    // ==================== TRIPS ====================
    match /trips/{document} {
      allow read, write: if isStaff();
    }

    // ==================== USERS ====================
    match /users/{document} {
      // Any staff member can read all users (for driver lists, etc.)
      allow read, write: if isStaff();
      // Allow a new staff user to create their own profile on first login
      allow create: if isStaff() &&
        request.auth.uid == document &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role in ['admin', 'driver', 'salesman'] &&
        request.resource.data.isActive == true;
      // Customers can read their own user doc
      allow read: if isCustomerAuth() && request.auth.uid == document;
      // Customers create their own profile via anonymous auth
      allow create: if isCustomerAuth() &&
        request.auth.uid == document &&
        request.resource.data.keys().hasOnly([
          'uid', 'phoneNumber', 'displayName', 'role',
          'photoURL', 'createdAt', 'updatedAt', 'isActive', 'temporaryPhoneLogin'
        ]) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.phoneNumber is string &&
        request.resource.data.role == 'customer' &&
        request.resource.data.isActive == true &&
        request.resource.data.temporaryPhoneLogin == true;
      allow update: if isCustomerAuth() &&
        request.auth.uid == document &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'updatedAt'
        ]);
      allow delete: if isTemporaryCustomer() && request.auth.uid == document;
    }

    // ==================== PARTIES ====================
    match /parties/{document} {
      allow read, write: if isStaff();
      allow read: if isCustomerAuth() &&
        resource.data.customerUserId == request.auth.uid;
      allow read: if isTemporaryCustomer() &&
        resource.data.phoneNumberNormalized ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phoneNumber;
      allow update: if isTemporaryCustomer() &&
        resource.data.phoneNumberNormalized ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phoneNumber &&
        request.resource.data.customerUserId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'customerUserId', 'updatedAt'
        ]);
    }

    // ==================== DELIVERIES ====================
    match /deliveries/{document} {
      allow read, write: if isStaff();
    }

    // ==================== LEADS ====================
    match /leads/{document} {
      allow read, write: if isStaff();
    }

    // ==================== DAILY RIDE SUMMARIES ====================
    match /daily-ride-summaries/{document} {
      allow read, write: if isStaff();
    }

    // ==================== DELIVERY TRACKING ====================
    match /delivery-tracking/{document} {
      allow read, write: if isStaff();
      allow read: if isCustomerAuth() &&
        get(/databases/$(database)/documents/parties/$(resource.data.partyId)
        ).data.customerUserId == request.auth.uid;
    }
  }
}
